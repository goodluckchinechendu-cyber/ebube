DirectoryIndex index.html
RewriteEngine On

# Compress text assets (main.dart.js shrinks a lot).
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/wasm image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  # Fingerprinted / static media can cache long.
  <FilesMatch "\.(woff2?|ttf|otf|png|jpg|jpeg|gif|svg|ico|wasm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # App shell JS changes every deploy — never immutable-cache it.
  <FilesMatch "^(main\.dart\.js|flutter\.js|flutter_bootstrap\.js|flutter_service_worker\.js)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
  </FilesMatch>

  # HTML + manifests: always revalidate so new deploys show up.
  <FilesMatch "^(index\.html|version\.json|manifest\.json)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
  </FilesMatch>
</IfModule>

# Flutter SPA: unknown paths under /agent/ serve index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]
