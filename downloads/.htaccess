# Serve Android APK downloads with the correct content type + filename.
# Missing .apk extension after download is a common “parse package” cause.
<IfModule mod_mime.c>
  AddType application/vnd.android.package-archive .apk
</IfModule>

RewriteEngine On
# Legacy paths (pre-volume layout) → /downloads/apks/...
# Keeps old app builds / bookmarks working after the path move.
RewriteRule ^(EbubeConnect(-arm64|-arm)?\.apk)$ apks/$1 [R=301,L]

<IfModule mod_headers.c>
  <FilesMatch "^EbubeConnect\.apk$">
    Header set Content-Type "application/vnd.android.package-archive"
    Header set Content-Disposition "attachment; filename=\"EbubeConnect.apk\""
    Header unset Content-Encoding
  </FilesMatch>
  <FilesMatch "^EbubeConnect-arm64\.apk$">
    Header set Content-Type "application/vnd.android.package-archive"
    Header set Content-Disposition "attachment; filename=\"EbubeConnect-arm64.apk\""
    Header unset Content-Encoding
  </FilesMatch>
  <FilesMatch "^EbubeConnect-arm\.apk$">
    Header set Content-Type "application/vnd.android.package-archive"
    Header set Content-Disposition "attachment; filename=\"EbubeConnect-arm.apk\""
    Header unset Content-Encoding
  </FilesMatch>
</IfModule>

Options -Indexes
