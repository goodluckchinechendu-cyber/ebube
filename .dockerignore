# Git / Docker build context (Railway builds from this).
.git
.cursor
.vscode
.idea
**/.DS_Store

# Secrets — never bake into the image
private/.env
private/flutter.env
private/*.jks
private/key.properties
app/android/key.properties

# Local junk
ebubeconnect_live_deployment.zip
error_log
agent_legacy
cgi-bin

# Flutter: keep web source; drop desktop/mobile toolchains for smaller context
app/.dart_tool
app/.idea
app/android
app/ios
app/linux
app/macos
app/windows
app/test
app/build
app/*.iml

# Root-only stale Flutter copies
/main.dart.js
/flutter.js
/flutter_bootstrap.js
/flutter_service_worker.js
/canvaskit
/assets
/icons
/favicon.ico
/favicon.png
/manifest.json
/version.json

# APK binaries live on Railway volume (/downloads/apks); page stays in image
downloads/*.apk
downloads/*.idsig
downloads/*.aab
downloads/apks/**
!downloads/apks/.gitkeep

backend/tests
backend/_quarantine
