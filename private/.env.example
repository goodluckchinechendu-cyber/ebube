# Copy to private/.env and fill real values. Never commit .env.
# This folder is blocked from the web by private/.htaccess.

DB_HOST=127.0.0.1
DB_USER=
DB_PASS=
DB_NAME=

# Prefer Resend on Railway (SMobile pattern): set MAIL_SMTP_PASS to your re_… key.
# Or set RESEND_API_KEY=re_… instead.
MAIL_SMTP_HOST=smtp.resend.com
MAIL_SMTP_PORT=465
MAIL_SMTP_USER=resend
MAIL_SMTP_PASS=
MAIL_SMTP_SECURE=ssl
MAIL_FROM_EMAIL=no-reply@ebubeconnect.com
MAIL_FROM_NAME=EbubeConnect
# RESEND_API_KEY=

SMOBILE_VTU_BASE_URL=https://smobileagent.com/api
SMOBILE_VTU_API_KEY=
SMOBILE_VTU_WEBHOOK_SECRET=

# Optional: used by scripts/setup_cloudflare_zone.sh
# CF_API_TOKEN=
